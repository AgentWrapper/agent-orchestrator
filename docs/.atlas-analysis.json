  "keyFeatures": [
    "Parallel AI coding agents in isolated git worktrees",
    "23 supported agent harnesses (Claude Code, Codex, Cursor, OpenCode, Aider, and more)",
    "Automatic CI failure routing back to the owning agent session",
    "Code review feedback loop — requested changes forwarded to the right worker",
    "Kanban dashboard showing session state, PRs, CI checks, and review status",
    "Orchestrator + worker model for supervised multi-agent workflows",
    "Mobile companion app for monitoring sessions and receiving push notifications",
    "Plugin system with 8 configurable slots (agent, runtime, workspace, tracker, SCM, notifier, terminal)",
    "CLI (`ao`) for spawning, monitoring, and managing sessions",
    "GitHub and GitLab SCM integration with webhook support",
    "Linear, GitHub, and GitLab issue tracker support",
    "Session resumption after restarts"
  ],
  "publicApiSurface": [
    "ao start [project]",
    "ao stop [project]",
    "ao status",
    "ao spawn [issue]",
    "ao batch-spawn <issues...>",
    "ao send <session> [message]",
    "ao review-check [project]",
    "ao dashboard",
    "ao open [target]",
    "ao verify [issue]",
    "ao doctor",
    "ao update",
    "ao session ls|attach|kill|cleanup|restore|claim-pr|remap",
    "ao setup dashboard|desktop|webhook|slack|discord",
    "ao plugin list|search|create|install|update|uninstall",
    "POST /api/webhooks",
    "GET /api/sessions",
    "GET /api/events (SSE)",
    "agent-orchestrator.yaml (project config)",
    "~/.agent-orchestrator/config.yaml (global config)"
  ]
