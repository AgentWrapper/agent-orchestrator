# Renderer build-time config (Vite). Copy to `.env` to override defaults.
# Only VITE_-prefixed vars are exposed to the renderer. NEVER put secrets here —
# these values ship inside the client bundle. (Clerk publishable keys are public
# by design; the Clerk SECRET key must NOT go here — it stays in Key Vault.)

# Local daemon base URL. Defaults to the running daemon (http://127.0.0.1:3001).
# VITE_AO_API_BASE_URL=http://127.0.0.1:3001

# Clerk publishable key for cloud sign-in. Defaults to our dev instance in code,
# so this is only needed to point at a different Clerk app (e.g. a pk_live_… in
# production).
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_dmFsdWVkLXdlYXNlbC0wLmNsZXJrLmFjY291bnRzLmRldiQ

# Hosted control-plane base URL. UNSET (default) → cloud sessions run through the
# LOCAL daemon exactly as today. Set it to route `/api/v1/cloud/*` at the hosted,
# multi-tenant control plane (Clerk Bearer JWT attached automatically). Example
# after Azure deploy: https://aocp-controlplane.<region>.azurecontainerapps.io
# VITE_AO_CONTROL_PLANE_URL=
