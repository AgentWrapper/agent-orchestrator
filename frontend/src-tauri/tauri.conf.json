{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Orchestrator",
  "identifier": "dev.agent-orchestrator.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer:tauri",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Orchestrator",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ao"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AgentWrapper/agent-orchestrator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMDNDRDEyMjU0NDA5MUUKUldRZUNVUWxFczBEek1Vb3U2bmFnVEJVbkF6MjR5ZXhZeEZ1NjNVSWNKOHh2dGtYQkhHNG14U2MK"
    }
  }
}
