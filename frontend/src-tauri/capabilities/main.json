{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capabilities for the main application window",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "process:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:event:default",
    "allow-daemon-get-status",
    "allow-daemon-start",
    "allow-daemon-stop",
    "allow-daemon-restart",
    "allow-keybindings-get",
    "allow-keybindings-set",
    "allow-keybindings-set-recording",
    "allow-app-state-get-migration",
    "allow-app-state-set-migration",
    "allow-update-settings-get",
    "allow-update-settings-set",
    "allow-update-settings-has-decision",
    "allow-app-scan-import-folder",
    "allow-terminal-save-dropped-file",
    "allow-telemetry-get-bootstrap",
    "allow-theme-set",
    "allow-window-set-overlay",
    "allow-window-is-full-screen",
    "allow-menu-action",
    "allow-notifications-show",
    "allow-clipboard-write-primary",
    "allow-app-get-version",
    "allow-browser-ensure",
    "allow-browser-set-bounds",
    "allow-browser-navigate",
    "allow-browser-clear",
    "allow-browser-capture",
    "allow-browser-request-mirror",
    "allow-browser-go-back",
    "allow-browser-go-forward",
    "allow-browser-reload",
    "allow-browser-stop",
    "allow-browser-destroy",
    "allow-browser-annotation-set-mode",
    "allow-browser-annotation-submit",
    "allow-browser-annotation-cancel",
    "allow-browser-forward-shortcut",
    "allow-updates-get-status",
    "allow-updates-check",
    "allow-updates-return-home",
    "allow-updates-download",
    "allow-updates-install",
    "allow-feature-builds-list",
    "allow-feature-builds-get-active"
  ]
}
