AO_CLOUD_LISTEN_ADDR=127.0.0.1:3010
AO_CLOUD_PUBLIC_URL=http://127.0.0.1:3010
AO_WEB_PUBLIC_URL=http://127.0.0.1:5174
# Local contributor default: the control plane starts a container per session.
# Build it once with `npm run cloud:build-image`.
AO_SANDBOX_PROVIDER=docker
AO_DOCKER_WORKER_IMAGE=ao-cloud-worker:local

AO_DATABASE_URL=postgresql://ao:ao@127.0.0.1:5432/ao_cloud_dev?sslmode=disable
AO_DATABASE_DIRECT_URL=postgresql://ao:ao@127.0.0.1:5432/ao_cloud_dev?sslmode=disable

AO_DAYTONA_API_URL=https://app.daytona.io/api
AO_DAYTONA_API_KEY=
AO_DAYTONA_TARGET=us
AO_DAYTONA_WORKER_SNAPSHOT=daytona-large

# 32 random bytes encoded as 64 hexadecimal characters.
AO_ENCRYPTION_KEY=
AO_WORKER_SIGNING_KEY=

# Local mode automatically reads `gh auth token` from the host and injects it
# into the control plane. Do not add a separate AO GitHub token here.

# Development-only upload path when the Daytona snapshot does not yet contain
# ao-worker. Production worker snapshots start the baked-in worker directly.
AO_WORKER_BINARY_PATH=
