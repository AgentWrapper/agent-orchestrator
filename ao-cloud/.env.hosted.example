# Copy to ao-cloud/.env.hosted on the persistent Azure VM. This file is ignored
# by Git. Do not reuse the local development passwords or cryptographic keys.

# The public HTTPS origin for the control plane and the deployed web application.
AO_CLOUD_PUBLIC_URL=https://cloud.example.com
AO_WEB_PUBLIC_URL=https://app.example.com
AO_CLOUD_DOMAIN=cloud.example.com
AO_CADDY_EMAIL=operator@example.com

# Hosted browser auth uses WorkOS. AO still owns orgs/memberships and uses
# signed WorkOS access tokens only as the identity proof into the control plane.
AO_CLOUD_AUTH_MODE=workos
AO_CLOUD_AUTH_PROVIDER=workos
AO_CLOUD_AUTH_ISSUER=https://api.workos.com
AO_CLOUD_AUTH_AUDIENCE=
AO_CLOUD_AUTH_JWKS_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://app.example.com/callback

# PostgreSQL only listens on the internal Compose network. Use a randomly
# generated URL-safe hexadecimal value: openssl rand -hex 32
AO_POSTGRES_USER=ao
AO_POSTGRES_PASSWORD=
AO_POSTGRES_DATABASE=ao_cloud

# Hosted mode does not enable the local CP email/password endpoints.

# The control plane encrypts stored coding-agent credentials and signs the
# short-lived worker/bootstrap tokens. Generate each with: openssl rand -hex 32
AO_ENCRYPTION_KEY=
AO_WORKER_SIGNING_KEY=

# Daytona is the hosted sandbox default. Its worker snapshot must contain the
# current worker image and its coding-agent dependencies.
AO_SANDBOX_PROVIDER=daytona
AO_DAYTONA_API_URL=https://app.daytona.io/api
AO_DAYTONA_API_KEY=
AO_DAYTONA_TARGET=us
AO_DAYTONA_WORKER_SNAPSHOT=
# Set to the immutable Git commit that produced the worker snapshot.
AO_WORKER_VERSION=

