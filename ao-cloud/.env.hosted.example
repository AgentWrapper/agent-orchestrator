# Copy to ao-cloud/.env.hosted on the AWS EC2 control-plane host. The real file
# is ignored by Git and must be mode 0600. Values here are placeholders only.
# Do not reuse local-development passwords or cryptographic keys.

# Public origins. Caddy terminates HTTPS; port 3010 remains private.
AO_CLOUD_LISTEN_ADDR=0.0.0.0:3010
AO_CLOUD_PUBLIC_URL=https://api.example.com
AO_WEB_PUBLIC_URL=https://app.example.com
AO_CLOUD_DOMAIN=api.example.com
AO_CADDY_EMAIL=operator@example.com

# Hosted browser auth uses WorkOS. AO still owns orgs/memberships and uses
# signed WorkOS access tokens only as the identity proof into the control plane.
AO_CLOUD_AUTH_MODE=workos
AO_CLOUD_AUTH_PROVIDER=workos
AO_CLOUD_ALLOW_PUBLIC_SIGNUP=false
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Leave these blank to derive the issuer, client ID check, and JWKS URL from
# WORKOS_CLIENT_ID.
AO_CLOUD_AUTH_ISSUER=
AO_CLOUD_AUTH_AUDIENCE=
AO_CLOUD_AUTH_JWKS_URL=

# Private RDS PostgreSQL connection. Require TLS. The direct URL is used for
# embedded migrations and may equal the runtime URL until a pooler is added.
AO_DATABASE_URL=postgresql://ao:REPLACE_WITH_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/ao_cloud?sslmode=require
AO_DATABASE_DIRECT_URL=postgresql://ao:REPLACE_WITH_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/ao_cloud?sslmode=require

# The control plane encrypts stored coding-agent credentials and signs the
# short-lived worker/bootstrap tokens. Generate each with: openssl rand -hex 32
AO_ENCRYPTION_KEY=
AO_WORKER_SIGNING_KEY=

# Hosted deployments use the GitHub App exclusively; never configure or pass a
# host `gh` token. Config validation pins this deployment to the expected App.
AO_GITHUB_AUTH_MODE=github-app
AO_GITHUB_APP_ID=
AO_GITHUB_APP_CLIENT_ID=
AO_GITHUB_APP_CLIENT_SECRET=
AO_GITHUB_APP_SLUG=
# This is the read-only path inside the control-plane container. Mount an
# absolute host PEM path to it and chmod the host file to 0600.
AO_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.private-key.pem
# Generate separate values with `openssl rand -hex 32`. Configure the webhook
# value in GitHub and keep the state value private to AO.
AO_GITHUB_APP_WEBHOOK_SECRET=
AO_GITHUB_APP_STATE_SECRET=

# Current hosted sandbox provider. New sessions use the exact task-definition
# revision below, whose worker image must be pinned to an immutable ECR digest.
AO_SANDBOX_PROVIDER=ecs
AO_MAX_ACTIVE_SANDBOXES_PER_ORG=12
AO_ECS_REGION=eu-north-1
AO_ECS_CLUSTER=ao-cloud-workers
AO_ECS_TASK_DEFINITION=ao-cloud-worker:REPLACE_WITH_REVISION
AO_ECS_CONTAINER_NAME=worker
AO_ECS_SUBNETS=subnet-REPLACE_ME,subnet-REPLACE_ME
AO_ECS_SECURITY_GROUPS=sg-REPLACE_ME
# The current demo uses public subnets. Set false after moving workers to
# private subnets with working NAT or equivalent controlled egress.
AO_ECS_ASSIGN_PUBLIC_IP=true

# Vercel values do not belong in this EC2 file. Configure these in Vercel:
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WEB_URL, NEXT_PUBLIC_AO_AUTH_MODE,
# NEXT_PUBLIC_WORKOS_REDIRECT_URI, WORKOS_CLIENT_ID, WORKOS_API_KEY, and
# WORKOS_COOKIE_PASSWORD. See ao-cloud/README.md for placement and values.
